    <!-- GitHub -->
    <string name="github_title">GitHub</string>
    <string name="github_connect_title">உங்கள் GitHub கணக்கை இணைக்கவும்</string>
    <string name="github_connect_body">நுண்ணிய அளவிலான தனிப்பட்ட அணுகல் டோக்கனை ஒட்டவும். அது Android Keystore மூலம் மறைகுறியாக்கப்பட்டு இந்த தொலைபேசியில் மட்டுமே சேமிக்கப்படும். GitHub களஞ்சிய அணுகலுக்கு மட்டுமே — AI இயக்கத்திற்கு அல்ல.</string>
